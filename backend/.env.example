# ---------- Server ----------
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins (the frontend URL[s])
CLIENT_ORIGINS=http://localhost:5173
# Set to 1 when running behind a reverse proxy / load balancer (needed for rate limiting + secure cookies)
TRUST_PROXY=0
LOG_LEVEL=info

# ---------- Database ----------
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>/playlocal?retryWrites=true&w=majority
MONGO_URI=
# Build indexes on startup (recommended in dev; in prod you may prefer building them out-of-band)
MONGO_AUTO_INDEX=true

# ---------- Auth ----------
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Admin sessions expire sooner than user sessions
ADMIN_JWT_EXPIRES_IN=1d
COOKIE_NAME=pl_session
# Cookies: use SameSite=none + Secure=true when frontend and API are on different sites (HTTPS only)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ---------- Images ----------
# cloudinary | local  (local stores files in ./uploads and serves them at /uploads — dev only)
STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=playlocal
# Public base URL of this API (used to build URLs for the local storage driver)
PUBLIC_API_URL=http://localhost:5000
# Optional: serve the built frontend from this server (single-host deploy), e.g. ../frontend/dist
CLIENT_DIST_DIR=
# Folder for the local storage driver
UPLOAD_DIR=uploads

# ---------- Phone OTP login ----------
# console = OTP is printed in the backend terminal (development only, refused in production)
# msg91   = MSG91 OTP API (India; needs a DLT-approved OTP template)
# twilio  = Twilio Messages API
SMS_PROVIDER=console
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5
RATE_LIMIT_OTP_MAX=10
# MSG91 (https://control.msg91.com) — template must contain the ##OTP## variable
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Twilio — use either TWILIO_FROM (a sender number) or TWILIO_MESSAGING_SERVICE_SID
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# ---------- Domain ----------
# UTC offset used to interpret tournament dates (yyyy-mm-dd) — e.g. +05:30 for India
APP_UTC_OFFSET=+05:30

# ---------- Geocoding (optional) ----------
# When enabled, venue addresses without coordinates are geocoded via Nominatim (OpenStreetMap)
GEOCODING_ENABLED=false
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=PlayLocal/0.1 (contact@example.com)

# ---------- Rate limits (requests per window) ----------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_REPORT_MAX=10
RATE_LIMIT_UPLOAD_MAX=30
RATE_LIMIT_GLOBAL_MAX=1000

# ---------- Admin accounts ----------
# Comma-separated 10-digit Indian mobile numbers that own the admin console. Synced on every
# server start and by `npm run seed` / `npm run sync-admins`: listed numbers become admins,
# unlisted admins are demoted. Required in production. Everyone logs in with phone + OTP.
ADMIN_NAME=PlayLocal Admin
ADMIN_PHONES=
