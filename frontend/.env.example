# Base URL of the API. Leave as /api in development (Vite proxies it) or when the
# frontend and API share a domain. For a separate API domain use e.g. https://api.playlocal.in/api
VITE_API_URL=/api
# Dev only: where the Vite dev server proxies /api and /uploads
VITE_DEV_API_PROXY=http://localhost:5000
VITE_DEV_PORT=5173
VITE_APP_NAME=PlayLocal
# IANA timezone used to display tournament dates
VITE_APP_TIMEZONE=Asia/Kolkata
# Currency used to display prize money / entry fee (ISO 4217)
VITE_CURRENCY=INR
VITE_LOCALE=en-IN
# How often (ms) to poll for unread notifications
VITE_NOTIFICATION_POLL_MS=60000
